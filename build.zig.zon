.{
    .name = .zide,
    .version = "0.0.1",
    // anyzig dispatches this EXACT version (despite the "minimum" name) —
    // keep it matching the toolchain the project is actually tested with.
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x5e89543fc18082dd,
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "libs",
    },
    .dependencies = .{
        .dvui = .{ .path = "libs/dvui" },
        .ziglua = .{ .path = "libs/ziglua" },
        .vaxis = .{ .path = "libs/libvaxis" },
    },
}
